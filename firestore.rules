rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function owner() {
      return signed() && exists(/databases/$(db)/documents/owners/$(request.auth.uid));
    }
    function isSuperadmin() {
      // mkSup() en index.html guarda el documento de cada superadmin con su
      // UID como ID (doc(db,'superadmins', c.user.uid), igual que se hace acá
      // con "owners"), no con el email. La versión anterior de esta regla
      // buscaba el documento por email y exigía email_verified == true (que
      // la app tampoco pide nunca), así que nunca podía coincidir con nada:
      // ningún superadmin podía entrar. Se corrige para buscar por UID, igual
      // que owner().
      return signed() && exists(/databases/$(db)/documents/superadmins/$(request.auth.uid));
    }
    function member(e) {
      return signed() && exists(/databases/$(db)/documents/events/$(e)/members/$(request.auth.uid));
    }
    function mrole(e) {
      return get(/databases/$(db)/documents/events/$(e)/members/$(request.auth.uid)).data.role;
    }
    function admin(e) {
      return owner() || isSuperadmin() || (member(e) && mrole(e) == 'A');
    }
    function see(e) {
      return owner() || isSuperadmin() || member(e);
    }

    match /owners/{u} {
      allow read: if signed() && request.auth.uid == u;
    }

    match /superadmins/{uid} {
      allow read: if owner() || (signed() && request.auth.uid == uid);
      allow write: if owner();
    }

    match /joins/{code} {
      allow get: if signed();
      allow list: if false;
      allow create, update, delete: if owner() || isSuperadmin();
    }

    match /events/{e} {
      allow read: if see(e);
      allow create: if owner() || isSuperadmin();
      allow delete: if owner();
      allow update: if owner() || isSuperadmin()
        || (admin(e) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['theme']));

      match /items/{id} {
        allow read: if see(e);
        allow create, update, delete: if admin(e);
      }
      match /plans/{id} {
        allow read: if see(e);
        allow create, update, delete: if admin(e);
      }
      match /guests/{id} {
        allow read: if see(e);
        allow create, delete: if admin(e);
        allow update: if admin(e) || (member(e)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inCount', 'arrivedAt', 'arrivedBy']));
      }
      match /codes/{id} {
        allow read: if owner() || isSuperadmin();
        allow create, update, delete: if owner() || isSuperadmin();
      }
      match /members/{uid} {
        allow read: if signed() && (request.auth.uid == uid || owner() || isSuperadmin());
        allow create, update: if signed() && request.auth.uid == uid
          && exists(/databases/$(db)/documents/events/$(e)/codes/$(request.resource.data.code))
          && get(/databases/$(db)/documents/events/$(e)/codes/$(request.resource.data.code)).data.role == request.resource.data.role
          && get(/databases/$(db)/documents/events/$(e)/codes/$(request.resource.data.code)).blocked != true;
        allow delete: if owner() || isSuperadmin();
      }
    }
  }
}
